# ============================================================
# GOJO SSH+WS RELAY — NGINX CONFIG
# ============================================================
# I switched this to the stream module. My bridge (proxy.py) is
# a raw TCP relay into dropbear — it never speaks HTTP back, so
# the http-module's proxy_pass (which expects an HTTP response
# from the upstream) was the wrong tool and caused "upstream
# connect error ... protocol error". The stream module proxies
# raw bytes at Layer 4, which matches what my bridge actually is.
#
# I'm relying on Cloud Run's default TCP startup probe here —
# it just needs to successfully open a TCP connection to my
# port, it doesn't require an HTTP 200 response. That's also
# why I dropped the separate http{} block I had for /healthz:
# nginx won't let me bind the same port in both an http{} and a
# stream{} block, and a TCP-level check is all Cloud Run needs
# by default anyway.
# ============================================================

load_module /usr/lib/nginx/modules/ngx_stream_module.so;

worker_processes auto;
worker_rlimit_nofile 65535;

events {
    worker_connections 8192;
}

stream {
    server {
        # Cloud Run injects PORT at runtime; entrypoint.sh substitutes
        # it into this file before nginx starts.
        listen __PORT__;

        # Raw TCP passthrough straight to my bridge. No HTTP parsing
        # or validation happens here — my bridge handles the fake-WS
        # handshake bytes directly now.
        proxy_pass 127.0.0.1:8081;
        proxy_timeout 3600s;
        proxy_connect_timeout 5s;

        # I widened this to match the buffer size I set on the bridge
        # side — the default here is much smaller and was likely
        # contributing to the ping spikes I saw under sustained
        # speedtest load.
        proxy_buffer_size 256k;
        proxy_socket_keepalive on;
        proxy_socket_rcvbuf 262144;
        proxy_socket_sndbuf 262144;
    }
}

